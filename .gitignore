# Dependencies (não usadas neste site estático, mas prevenidas)
node_modules/
dist/
.cache/
# NÃO ignore build/: desde a expansão institucional, é o gerador real das
# páginas novas (nav.mjs, partials, layouts, conteúdo por página) — é
# código-fonte, não artefato. O HTML gerado por ele fica fora daqui (vai
# para a raiz e para cada pasta de página), build/ em si é só os módulos.

# Ambiente / segredos — NUNCA versionar
.env
.env.*
*.pem
*.key
id_rsa*
deploy_key*

# Logs
*.log
npm-debug.log*

# Sistema operacional / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Testes de navegador (pasta testes/) — artefatos locais
testes/test-results/
testes/playwright-report/
